# Default: live MyMemory (no key) — GraphQL wraps https://api.mymemory.translated.net
# TRANSLATION_MODE=live
# TRANSLATE_PROVIDER=mymemory

# Tests / offline demos
# TRANSLATION_MODE=mock

# Optional higher MyMemory quota (10k words/day)
# MYMEMORY_EMAIL=you@example.com

# Optional DeepL instead of MyMemory
# TRANSLATE_PROVIDER=deepl
# DEEPL_API_KEY=your-deepl-key
# DEEPL_API_URL=https://api-free.deepl.com/v2/translate
